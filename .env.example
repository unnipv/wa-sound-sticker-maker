PORT=8080
# Optional passcode gate for friends (leave empty to disable)
APP_PASSCODE=
# Enable the server-owned WhatsApp relay account (true/false)
RELAY_ENABLED=true
# Token protecting /admin and /api/relay/* endpoints
ADMIN_TOKEN=change-me-to-a-random-secret
# Max upload size in MB
MAX_UPLOAD_MB=100
# Optional public base URL (e.g. https://xxxx.trycloudflare.com)
PUBLIC_BASE_URL=
# Wire format for sound stickers: 134 (FutureProofMessage audioStickerMessage, Nov 2026 default) or 26 (legacy StickerMessage.audioMessage only)
WA_SOUND_WIRE_FORMAT=134
# Optional path to yt-dlp binary (defaults to ~/.local/bin/yt-dlp, then yt-dlp on PATH)
YTDLP_BIN=
