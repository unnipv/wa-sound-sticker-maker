{
  "name": "wa-sound-sticker-maker",
  "version": "2.0.0",
  "description": "Web app + CLI to make WhatsApp sound stickers (animated WebP + Opus audio) and deliver them to WhatsApp",
  "type": "module",
  "main": "server.js",
  "bin": {
    "wa-sound-sticker": "make.mjs"
  },
  "scripts": {
    "start": "node server.js",
    "make": "node make.mjs",
    "smoke": "bash scripts/smoke.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "baileys": "^7.0.0-rc14",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.0.2",
    "node-webpmux": "^3.2.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  }
}
